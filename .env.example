# TradingAgents-KR 환경변수 예시.
#   cp .env.example .env  →  값을 채운다.  .env 는 커밋하지 않는다.
# 값을 비워 두거나 주석(#) 처리한 변수는 기본값을 쓴다.

# ── LLM ────────────────────────────────────────────────────────────────
# Claude Code 헤드리스 단일 백엔드 (ADR-0001). 외부 LLM API 키(OpenAI/Anthropic/Gemini 등)는
# 쓰지 않으니 넣지 않는다. 호스트에서 `claude` 로 로그인해 두면 Max/Pro 플랜 쿼터를 쓴다.

# ── 데이터 vendor 키 ───────────────────────────────────────────────────
# DART 인증키 (무료): https://opendart.fss.or.kr/ — 재무제표·공시·회사 개요
DART_API_KEY=

# 한국은행 ECOS 인증키 (무료): https://ecos.bok.or.kr/ — 기준금리·물가·환율 등 거시 지표
ECOS_API_KEY=

# 네이버 API HUB 클라이언트 ID/Secret — 종목 뉴스
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# KRX 로그인 — 투자자별 수급 조회(pykrx). 없으면 수급 조회가 실패한다.
KRX_ID=
KRX_PW=

# ── 분석 설정 (DEFAULT_CONFIG 덮어쓰기) ───────────────────────────────
# 아래는 모두 기본값이다. 바꾸려면 주석을 풀어 값을 쓴다.
#TRADINGAGENTS_DEEP_THINK_LLM=sonnet       # 리서처·매니저·트레이더·토론자 모델
#TRADINGAGENTS_QUICK_THINK_LLM=haiku       # 분석가 모델
#TRADINGAGENTS_EFFORT=high                 # deep 티어 Claude Code --effort
#TRADINGAGENTS_QUICK_EFFORT=medium         # quick 티어 --effort
#TRADINGAGENTS_OUTPUT_LANGUAGE=Korean      # 보고서 언어
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1         # 강세/약세 토론 라운드
#TRADINGAGENTS_MAX_RISK_ROUNDS=1           # 리스크 토론 라운드
#TRADINGAGENTS_CHECKPOINT_ENABLED=false    # true 면 노드마다 저장해 중단된 실행을 이어 간다
#TRADINGAGENTS_BENCHMARK_TICKER=           # 알파 계산 기준 종목코드. 비우면 기본 벤치마크

# ── Claude Code 호출 ──────────────────────────────────────────────────
#TRADINGAGENTS_CLAUDE_CONCURRENCY=2        # 동시에 실행할 claude 프로세스 수 (양의 정수)
#TRADINGAGENTS_CLAUDE_TIMEOUT=             # 호출 타임아웃(초). 비우면 effort 별 기본: low 180 / medium 300 / high 600 / xhigh 900 / max 1200

# ── 경로 ──────────────────────────────────────────────────────────────
# 비우면 ~/.tradingagents 아래를 쓴다 (logs / cache / memory/trading_memory.md).
#TRADINGAGENTS_RESULTS_DIR=
#TRADINGAGENTS_CACHE_DIR=
#TRADINGAGENTS_MEMORY_LOG_PATH=
# Docker: 결과·보고서·메모리 로그를 둘 호스트 폴더. 비우면 tradingagents_data 볼륨.
#TRADINGAGENTS_DATA_DIR=./data

# ── 웹 API (api/) ─────────────────────────────────────────────────────
#TRADINGAGENTS_API_PORT=8000                           # uvicorn 포트
#TRADINGAGENTS_API_CORS_ORIGINS=http://localhost:4321  # 콤마로 구분한 허용 origin

# ── 기타 ──────────────────────────────────────────────────────────────
#TRADINGAGENTS_NO_UPDATE_CHECK=1           # CLI 시작 시 새 버전 확인을 끈다
