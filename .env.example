# TradingAgents-KR — 한국 증시 (KOSPI/KOSDAQ) 전용 하드 포크.
# Claude Code 헤드리스가 **유일한** LLM 백엔드 (ADR-0001). OAuth 토큰으로
# 인증하므로 OpenAI / Anthropic / Gemini 등 외부 LLM API 키는 **설정하지 마세요**.

# -----------------------------------------------------------------------------
# KRX 데이터 vendor 키
# -----------------------------------------------------------------------------

# DART (금융감독원 Open DART — 공시/재무제표). **필수**. 무료 발급, 즉시 승인.
# https://opendart.fss.or.kr/ 에서 가입 후 [인증키 신청/관리] 에서 40자 키 발급.
DART_API_KEY=

# ECOS (한국은행 거시 지표 — 기준금리, CPI, GDP 등). **선택**. 설정 시 거시 분석가가
# 실 데이터를 사용. 미설정 시 해당 지표 섹션은 안내문으로 대체됩니다. 무료 발급.
# https://ecos.bok.or.kr/ 에서 가입 후 [서비스 이용] → [OPEN API 서비스] 에서 신청.
#ECOS_API_KEY=

# KRX 로그인 (pykrx 투자자 흐름 데이터용). **선택**. 설정 시 "기관/외국인 수급" 등
# 선행 지표를 수집. 미설정 시 투자자 흐름 섹션은 안내문으로 대체.
# https://data.krx.co.kr/ 회원 ID / 비밀번호.
#KRX_ID=
#KRX_PW=

# -----------------------------------------------------------------------------
# TradingAgents 기본 설정 오버라이드 (전부 선택)
# -----------------------------------------------------------------------------
# 미설정 시 tradingagents/default_config.py 의 기본값이 사용됩니다.

# 경로. 미설정 시 ~/.tradingagents/{logs,cache,memory}.
#TRADINGAGENTS_RESULTS_DIR=
#TRADINGAGENTS_CACHE_DIR=
#TRADINGAGENTS_MEMORY_LOG_PATH=

# 출력 언어. 기본 "Korean". "English" 로 영어 리포트 생성 가능.
#TRADINGAGENTS_OUTPUT_LANGUAGE=Korean

# 벤치마크 티커 (알파 기준). 기본 KOSPI (^KS11 또는 KODEX 200 등 정의).
#TRADINGAGENTS_BENCHMARK_TICKER=

# Claude Code 모델 티어. 기본 sonnet (deep) / haiku (quick).
# 사용 가능한 값: sonnet, haiku, opus (plan 제한에 따라 다름).
#TRADINGAGENTS_DEEP_THINK_LLM=sonnet
#TRADINGAGENTS_QUICK_THINK_LLM=haiku

# Reasoning effort (Claude 의 thinking budget). 기본 high (deep) / medium (quick).
# 값: low, medium, high.
#TRADINGAGENTS_EFFORT=high
#TRADINGAGENTS_QUICK_EFFORT=medium

# 디베이트 라운드. 기본 1. 증가 시 LLM 호출 수 비례 증가.
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1

# 체크포인트 (중단 시 재개). 기본 false. true 로 설정 시 LangGraph 체크포인트 활성화.
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# 시작 시 upstream 업데이트 안내 끄기.
#TRADINGAGENTS_NO_UPDATE_CHECK=1

# -----------------------------------------------------------------------------
# Claude Code 어댑터 튜닝 (선택)
# -----------------------------------------------------------------------------

# 동시 subprocess 수. 기본은 코드 내 정의 (일반적으로 2-4). Max 플랜 쿼터 보호용.
#TRADINGAGENTS_CLAUDE_CONCURRENCY=2

# 단일 호출 타임아웃 (초). 기본은 코드 내 정의. 긴 리서치 호출에서 타임아웃 시 증가.
#TRADINGAGENTS_CLAUDE_TIMEOUT=300

# -----------------------------------------------------------------------------
# Docker 실행 (선택)
# -----------------------------------------------------------------------------

# docker-compose 가 호스트 경로를 /home/appuser/.tradingagents 로 바인드. 미설정 시
# tradingagents_data 네임드 볼륨 사용.
#TRADINGAGENTS_DATA_DIR=./data

# -----------------------------------------------------------------------------
# ⚠️ 디버깅 escape hatch — 운영 환경 사용 금지 (CLAUDE.md §4.6)
# -----------------------------------------------------------------------------
# Claude Code 어댑터를 `claude --bare` 모드로 전환합니다. OAuth 토큰이 아닌
# ANTHROPIC_API_KEY 를 사용 — Max 플랜 쿼터를 **활용하지 못합니다**. 로컬
# 디버깅에서만 사용하세요.
#TRADINGAGENTS_CLAUDE_BARE=1
#ANTHROPIC_API_KEY=
